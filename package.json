{
  "name": "angular-dashboard-template",
  "version": "0.0.0",
  "scripts": {
    "ng": "ng",
    "start": "concurrently -k -n bff,app -c magenta,cyan \"npm:start:bff\" \"npm:start:app\"",
    "start:app": "ng serve --proxy-config proxy.conf.json",
    "start:bff": "npm --prefix mock-bff start",
    "build": "ng build",
    "watch": "ng build --watch --configuration development",
    "test": "ng test",
    "test:ci": "ng test --watch=false",
    "postinstall": "npm --prefix mock-bff install --no-audit --no-fund"
  },
  "private": true,
  "packageManager": "npm@11.19.1",
  "dependencies": {
    "@ag-grid-community/locale": "^36.2.0",
    "@angular/cdk": "^22.2.0",
    "@angular/common": "^22.2.0",
    "@angular/compiler": "^22.2.0",
    "@angular/core": "^22.2.0",
    "@angular/forms": "^22.2.0",
    "@angular/platform-browser": "^22.2.0",
    "@angular/router": "^22.2.0",
    "@jsverse/transloco": "^8.4.0",
    "@ng-icons/core": "^32.2.0",
    "@ng-icons/lucide": "^32.2.0",
    "@spartan-ng/brain": "^1.5.0",
    "ag-grid-angular": "^36.2.0",
    "ag-grid-community": "^36.2.0",
    "chart.js": "^4.5.1",
    "class-variance-authority": "^0.7.0",
    "clsx": "^2.1.1",
    "ng2-charts": "^10.0.0",
    "rxjs": "~7.8.0",
    "tailwind-merge": "^3.5.0",
    "tslib": "^2.3.0"
  },
  "devDependencies": {
    "@angular/build": "^22.2.0",
    "@angular/cli": "^22.2.0",
    "@angular/compiler-cli": "^22.2.0",
    "@spartan-ng/cli": "^1.5.0",
    "@tailwindcss/postcss": "^4.3.3",
    "concurrently": "^10.0.5",
    "jsdom": "^30.0.0",
    "postcss": "^8.5.28",
    "prettier": "^3.8.1",
    "tailwindcss": "^4.3.3",
    "tw-animate-css": "^1.4.0",
    "typescript": "~6.0.2",
    "vitest": "^5.0.0"
  }
}
